# Example configuration for a separate development environment.
# Copy to .env.development.local and replace placeholders.
# Never use production Firebase credentials or identifiers.

# Firebase client configuration (included in the browser bundle)
REACT_APP_FIREBASE_KEY=your-firebase-web-api-key
REACT_APP_FIREBASE_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_MESSAGING_APP_ID=your-firebase-app-id

# MySportsFeeds API configuration
REACT_APP_API_BASE_URL=/api/mysportsfeeds
REACT_APP_SEASON=2026-2027-regular
REACT_APP_SEASON_OPENS=your-season-start-timestamp-in-milliseconds

# Server-only credentials: never prefix these with REACT_APP_
MYSPORTSFEEDS_API_KEY=your-api-key
MYSPORTSFEEDS_PASSWORD=your-api-password

# Optional standalone server settings
# PORT=3001
# HOST=localhost
# CORS_ALLOW_ORIGIN=http://localhost:3000
